[Unit]
Description=SMSLY Hosting Encrypted Database Backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# backup.sh loads /opt/smsly-hosting/.env safely (without shell execution)
# and falls back BACKUP_PASS to BACKUP_ENCRYPTION_KEY, failing closed if unset.
ExecStart=/opt/smsly-hosting/scripts/backup.sh
