# Envoy Sidecar Configuration Template
# ======================================
# Transparent mTLS proxy for user services on the smsly-hosting platform.
# Uses SPIRE SDS (Secret Discovery Service) for dynamic certificate management.
#
# Traffic flow:
#   Inbound:  other_service -> envoy:80 -> app:{{APP_PORT}}  (mTLS terminated)
#   Outbound: app -> envoy:8080 -> other_service:80          (mTLS originated)
#
# Placeholders (replaced at runtime):
#   {{APP_PORT}}          - Application's internal port (e.g., 8000)
#   {{TRUST_DOMAIN}}      - SPIFFE trust domain (ecosystem.local)
#   {{SERVICE_NAME}}      - Service name for DNS resolution
#   {{SPIRE_AGENT_SOCKET}} - Path to SPIRE agent UDS socket

node:
  id: "{{SERVICE_NAME}}"
  cluster: "{{SERVICE_NAME}}"

static_resources:
  listeners:
  # ── Inbound listener: terminates mTLS from other services ──
  - name: inbound
    address:
      socket_address:
        address: 0.0.0.0
        port_value: 80
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: inbound
          codec_type: AUTO
          forward_client_cert_details: SANITIZE_SET
          set_current_client_cert_details:
            uri: true
          route_config:
            name: inbound_route
            virtual_hosts:
            - name: inbound_service
              domains: ["*"]
              request_headers_to_remove: ["x-spiffe-id", "x-forwarded-spiffe-id", "x-target-service"]
              routes:
              - match:
                  prefix: "/"
                route:
                  cluster: local_app
                  timeout: 30s
                  retry_policy:
                    retry_on: "5xx"
                    num_retries: 2
          http_filters:
          # CORS filter
          - name: envoy.filters.http.cors
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.cors.v3.Cors
          # BEGIN_RBAC_FILTER
          # RBAC authorization filter
          - name: envoy.filters.http.rbac
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
              stat_prefix: inbound_rbac
              rules:
                action: ALLOW
                policies:
                  spiffe_auth:
                    principals:
                    - authenticated:
                        principal_name:
                          safe_regex:
                            google_re2: {}
                            regex: "spiffe://{{TRUST_DOMAIN}}/service/.*"
                    permissions:
                    - url_path:
                        path:
                          safe_regex:
                            google_re2: {}
                            regex: ".*"
          # END_RBAC_FILTER
          # Router
          - name: envoy.filters.http.router
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

    transport_socket:
      name: envoy.transport_sockets.tls
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
        require_client_certificate: true
        common_tls_context:
           tls_certificate_sds_secret_configs:
           - name: default
             sds_config:
               resource_api_version: V3
               api_config_source:
                 api_type: GRPC
                 transport_api_version: V3
                 grpc_services:
                 - envoy_grpc:
                     cluster_name: spire_agent
           validation_context_sds_secret_config:
             name: ROOTCA
             sds_config:
               resource_api_version: V3
               api_config_source:
                 api_type: GRPC
                 transport_api_version: V3
                 grpc_services:
                 - envoy_grpc:
                     cluster_name: spire_agent

  # ── Outbound listener: originates mTLS to other services ──
  - name: outbound
    address:
      socket_address:
        address: 127.0.0.1
        port_value: 8080
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: outbound
          codec_type: AUTO
          route_config:
            name: outbound_route
            virtual_hosts:
            - name: outbound_service
              domains: ["*"]
              routes:
              - match:
                  prefix: "/"
                route:
                  cluster: dynamic_outbound_cluster
                  timeout: 30s
                  retry_policy:
                    retry_on: "5xx"
                    num_retries: 2
          http_filters:
          - name: envoy.filters.http.dynamic_forward_proxy
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.dynamic_forward_proxy.v3.FilterConfig
              dns_cache_config:
                name: dynamic_forward_proxy_cache_config
                dns_lookup_family: V4_ONLY
          - name: envoy.filters.http.router
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

  clusters:
  # ── Local application cluster ──
  - name: local_app
    connect_timeout: 1s
    type: STATIC
    load_assignment:
      cluster_name: local_app
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address:
                address: 127.0.0.1
                port_value: {{APP_PORT}}

  # ── SPIRE agent cluster (for SDS) ──
  - name: spire_agent
    connect_timeout: 1s
    type: STATIC
    http2_protocol_options: {}
    load_assignment:
      cluster_name: spire_agent
      endpoints:
      - lb_endpoints:
        - endpoint:
             address:
               pipe:
                 path: "{{SPIRE_AGENT_SOCKET}}"

  # ── Dynamic outbound cluster (for outbound mTLS) ──
  # Resolves destination Host header dynamically via Docker DNS instead of
  # routing back to {{SERVICE_NAME}}:80.
  - name: dynamic_outbound_cluster
    connect_timeout: 2s
    lb_policy: CLUSTER_PROVIDED
    cluster_type:
      name: envoy.clusters.dynamic_forward_proxy
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.clusters.dynamic_forward_proxy.v3.ClusterConfig
        dns_cache_config:
          name: dynamic_forward_proxy_cache_config
          dns_lookup_family: V4_ONLY
    transport_socket:
      name: envoy.transport_sockets.tls
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
        common_tls_context:
           tls_certificate_sds_secret_configs:
           - name: default
             sds_config:
               resource_api_version: V3
               api_config_source:
                 api_type: GRPC
                 transport_api_version: V3
                 grpc_services:
                 - envoy_grpc:
                     cluster_name: spire_agent
           combined_validation_context:
             default_validation_context:
               match_typed_subject_alt_names:
               - san_type: URI
                 matcher:
                   prefix: "spiffe://{{TRUST_DOMAIN}}/service/"
             validation_context_sds_secret_config:
               name: ROOTCA
               sds_config:
                 resource_api_version: V3
                 api_config_source:
                   api_type: GRPC
                   transport_api_version: V3
                   grpc_services:
                   - envoy_grpc:
                       cluster_name: spire_agent

admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 9901
