:80 {
	# JSON access log (stdout -> docker logs -> Loki): timestamp + host +
	# URI let operators correlate a user-reported Request ID by time window.
	log {
		output stdout
		format json
	}

	# Security headers on every response, including the 503 fallback page
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-X-SMSLY-Control-Plane
	}

	# Healthcheck endpoint for Docker
	handle /health {
		respond "OK" 200
	}

	# Proxy route health recheck to backend
	@api_recheck path /api/v1/system/route-recheck/*
	handle @api_recheck {
		reverse_proxy backend:8000
	}

	# Serve the "Service waking up" page for everything else
	handle {
		error 503
	}

	handle_errors 503 {
		header Content-Type "text/html"
		header Cache-Control "no-store, no-cache, must-revalidate"
		header Pragma "no-cache"
		header Expires "0"
		header Retry-After "15"
		header X-SMSLY-Route-Fallback "true"
		# Per-request ID for support correlation (also rendered into the
		# page via templates below). Caddy generates http.request.uuid.
		header X-SMSLY-Request-ID "{http.request.uuid}"

		# Master Caddy marks routing-disabled hosts with
		# X-SMSLY-Fallback-Reason: disabled — serve the dedicated page.
		# Pages live under /etc/rb-fallback (directory bind — survives
		# git-pull inode replacement, unlike single-file binds).
		@route_disabled header X-SMSLY-Fallback-Reason disabled
		handle @route_disabled {
			root * /etc/rb-fallback
			rewrite * /disabled.html
			templates
			file_server
		}

		# Default: service waking up page
		handle {
			root * /etc/rb-fallback
			rewrite * /index.html
			templates
			file_server
		}
	}
}
