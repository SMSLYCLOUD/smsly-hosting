FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend tunnel server package
COPY backend/ ./

# Create non-root user for runtime
RUN addgroup --system tunnel && adduser --system --ingroup tunnel tunnel && \
    chown -R tunnel:tunnel /app
USER tunnel

# Expose ports
EXPOSE 8080

# Run tunnel server
CMD ["python", "-m", "apps.deployments.services.tunnels.server"]
