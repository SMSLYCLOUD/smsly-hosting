[Unit]
Description=Trulay Grid Cryptographic Controller & DB Point-of-Contact Gate (grid-cryptd)
After=network-online.target smsly-root-vault.service
Wants=network-online.target
Before=docker.service

[Service]
Type=simple
EnvironmentFile=-/etc/smsly/cryptd.env
ExecStart=/usr/local/bin/grid-cryptd -mode=controller
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=15s

# Keep sub-master / per-service keys locked in RAM (never swapped or core-dumped)
LimitMEMLOCK=infinity
LimitCORE=0
CapabilityBoundingSet=CAP_IPC_LOCK CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_MKNOD CAP_NET_BIND_SERVICE CAP_SYS_ADMIN CAP_SYS_RAWIO
AmbientCapabilities=CAP_IPC_LOCK CAP_NET_BIND_SERVICE CAP_SYS_ADMIN

# Hardening without private mount-namespace isolation so LUKS2 mounts/umounts
# created via scripts/smsly-volume-crypt.sh are visible to dockerd on the host.
NoNewPrivileges=yes
RuntimeDirectory=smsly
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0750
StateDirectory=smsly/keystore
StateDirectoryMode=0700
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
