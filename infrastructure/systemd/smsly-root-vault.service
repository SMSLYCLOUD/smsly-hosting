[Unit]
Description=Trulay Grid External Root Vault Server (holds MK, derives weekly SMK_w)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/smsly/root-vault.env

[Service]
Type=simple
EnvironmentFile=-/etc/smsly/root-vault.env
ExecStart=/usr/local/bin/grid-cryptd -mode=root-vault
Restart=always
RestartSec=2s
TimeoutStartSec=20s
TimeoutStopSec=10s

LimitMEMLOCK=infinity
LimitCORE=0
CapabilityBoundingSet=CAP_IPC_LOCK CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_IPC_LOCK CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
StateDirectory=smsly-root-vault
StateDirectoryMode=0700
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
