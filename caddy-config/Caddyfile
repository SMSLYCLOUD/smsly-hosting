# SMSLY Caddyfile — FALLBACK TEMPLATE ONLY.
#
# This file is mounted into the Caddy container at /etc/caddy/Caddyfile.
# On a healthy deployment, caddy_manager.generate_caddyfile() OVERWRITES this
# file at runtime via /caddy-config/Caddyfile (a bind mount shared between
# the backend and caddy containers). Caddy never reads this template on
# reload unless the regeneration has never succeeded.
#
# The template below is intentionally minimal and uses only syntax that
# every caddy:2-alpine build (>= 2.6) understands. Do NOT add:
#   - `allow { ... }` inside on_demand_tls (added in 2.7.6, but the
#     operator never fills it in and an empty block trips older parsers)
#   - `output file /var/log/caddy/access.log` (the dir does not exist
#     in the alpine image; caddy silently fails to log)
#   - `handle /.well-known/acme-challenge/*` (steals HTTP-01 challenges
#     from caddy before the ACME solver can serve them; breaks issuance)
#
# Real routing logic lives in backend/services/caddy_manager.py. Edit that
# file, not this one.

{
	on_demand_tls {
		ask http://backend:8000/api/v1/services/check-domain/
	}
}

# Fallback site: any HTTPS request that arrives before the auto-generated
# Caddyfile has been written gets a 503. The backend's startup hook
# (apps/deployments/startup.py) regenerates the Caddyfile within ~3 s of
# boot, so this state should never be observable in normal operation.
:443 {
	respond "Grid is starting up, please retry in a few seconds." 503
}

# Port 80 — let Caddy handle ACME HTTP-01 natively, redirect everything
# else to HTTPS. The ACME solver must run on :80; do NOT intercept the
# challenge path here.
:80 {
	@not_ip not header_regexp host ^([0-9]{1,3}[.]){3}[0-9]{1,3}$
	@not_local not host localhost 127.0.0.1 *.local
	@has_host header_regexp host .+
	redir @has_host https://{host}{uri} 308
	handle {
		reverse_proxy backend:8000
	}
}
