# NOTE: This is a reference snippet for WebSocket-specific tuning, NOT the
# canonical configuration. The active edge proxy is caddy-config/Caddyfile.
# Do not deploy this file as-is. See docs/REVERSE_PROXY_DECISION.md.

# Optimized Caddy configuration for WebSockets
# Include this in your main Caddyfile

# Global options
{
    # Increase timeouts for WebSockets
    timeouts {
        read_body 30s
        read_header 10s
        write 60s
        idle 5m
    }
}

# WebSocket-specific configuration for your domain
# Replace example.com with your actual domain
example.com {
    # Standard TLS configuration
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    
    # WebSocket path - adjust to match your actual WebSocket path
    @websockets {
        path /ws/*
        header Connection *Upgrade*
        header Upgrade websocket
    }
    
    # Special handling for WebSocket connections
    handle @websockets {
        reverse_proxy localhost:8000 {
            # WebSocket-specific transport settings
            transport http {
                # Keep connections alive longer
                keepalive 30s
                
                # Increase timeouts for WebSockets
                timeout 5m
                
                # Optimize for WebSockets
                versions 1.1 2
            }
            
            # Add required headers for WebSockets
            header_up Connection "Upgrade"
            header_up Upgrade "websocket"
            
            # Disable compression for WebSockets
            header_down -Content-Encoding
        }
    }
    
    # Handle all other requests normally
    handle {
        reverse_proxy localhost:8000
        encode gzip
    }
    
    # Logging
    log {
        output file /var/log/caddy/websocket-access.log
        format json
        level INFO
    }
}