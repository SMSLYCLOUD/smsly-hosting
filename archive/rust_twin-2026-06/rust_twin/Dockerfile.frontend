# syntax=docker/dockerfile:1.7
#
# Frontend (Leptos) build. Produces a static WASM bundle that can be served
# by any static file server.
#
# The current rust_twin frontend is a Leptos demo with 4 routes. The main
# production UI is the Next.js 15 app at ../../frontend/. We don't ship the
# Leptos frontend by default.
#
# If you want to use it:
#   docker build -t rust_twin-frontend:latest -f Dockerfile.frontend .
#   docker run --rm -p 8081:8081 rust_twin-frontend:latest
#
# The build requires `cargo-leptos` to be installed on the host:
#   cargo install cargo-leptos --locked
#
# Then uncomment the FROM line below and the build steps.

# FROM rust:1.82-slim-bookworm
# RUN cargo install cargo-leptos --locked
# WORKDIR /build
# COPY . .
# RUN cargo leptos build --release
# FROM nginx:alpine
# COPY --from=0 /build/target/site /usr/share/nginx/html
# EXPOSE 80
