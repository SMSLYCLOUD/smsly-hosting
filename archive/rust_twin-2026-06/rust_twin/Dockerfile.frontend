# Syntax: docker/dockerfile:1
# Build Leptos CSR WASM application using Trunk

# Stage 1: Build Environment
FROM rust:1.80-slim-bookworm AS builder

# Install WASM target and Trunk bundler
RUN rustup target add wasm32-unknown-unknown
RUN cargo install trunk
RUN apt-get update && apt-get install -y pkg-config libssl-dev build-essential && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# Build the frontend crate via Trunk
WORKDIR /app/crates/frontend
RUN trunk build --release

# Stage 2: Nginx Static Server
FROM nginx:alpine AS runtime

# Copy compiled WASM and JS assets to Nginx html directory
COPY --from=builder /app/crates/frontend/dist /usr/share/nginx/html

# Provide a custom default.conf to route 404s back to index.html (Client-Side Routing)
RUN echo " \
server { \n\
    listen 80; \n\
    server_name localhost; \n\
    root /usr/share/nginx/html; \n\
    index index.html; \n\
    location / { \n\
        try_files \$uri \$uri/ /index.html; \n\
    } \n\
} \
" > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]