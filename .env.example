# Environment variables for SMSly Hosting
# Copy this to .env and fill in all REQUIRED values

# ===========================================
# REQUIRED - Service will not start without these
# ===========================================

# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ===========================================
# Database & Redis (defaults work for docker-compose)
# ===========================================
# These MUST match docker-compose.prod.yml expectations
POSTGRES_DB=smsly_hosting
POSTGRES_USER=smsly_admin
POSTGRES_PASSWORD=
DATABASE_URL=postgres://smsly_admin:${POSTGRES_PASSWORD}@db:5432/smsly_hosting
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
# NOTE: Do NOT set REDIS_URL or CELERY_BROKER_URL here.
# settings.py builds these automatically from defaults/env configs.

# REQUIRED in production - backend crashes without it (fail-closed security).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# REQUIRED in production for PgCat service.
# Generate: python3 -c "import secrets; print(secrets.token_hex(24))"
PGCAT_ADMIN_PASSWORD=

# --- INFRASTRUCTURE & PROVISIONING ---
# Branch to use for remote server updates (default: main)
SMSLY_BRANCH=main

# Remote repository URL for provisioning (default: SMSLYCLOUD/smsly-hosting.git)
# Token injection is handled automatically by the provisioner.
SMSLY_GIT_REMOTE=https://github.com/SMSLYCLOUD/smsly-hosting.git

# Optional explicit inter-service HMAC secret (falls back to SECRET_KEY if unset)
GATEWAY_SECRET=

# ===========================================
# OAuth (Optional - enables GitHub/Google login)
# ===========================================
# Create OAuth apps and set these credentials, then restart the backend.
# The backend will auto-configure the Django Site + SocialApps on startup.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================
# Billing (Optional)
# ===========================================
# Stripe (recommended for recurring subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Non-Stripe providers (Flutterwave/Cryptomus) use one-time "period" activations
BILLING_CURRENCY=USD
BILLING_PRO_AMOUNT=29.00
BILLING_PRO_PERIOD_DAYS=30

# Flutterwave (card/bank payments)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Cryptomus (crypto payments)
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# ===========================================
# CORS Configuration
# ===========================================
# Set to True ONLY for local development
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
# Legacy function-based tunnel API (keep disabled unless required)
ENABLE_LEGACY_TUNNEL_API=False
# Provisioner SSH host-key verification (set False only for bootstrap/trusted labs)
SMSLY_STRICT_SSH_HOST_KEY_CHECK=True

# ===========================================
# Container Registry (required for deployments)
# ===========================================
CONTAINER_REGISTRY_URL=registry.smsly.cloud
REGISTRY_USER=
REGISTRY_PASSWORD=

# ===========================================
# AI Intelligence Providers (optional)
# ===========================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
JULES_API_KEY=
JULES_MODEL=jules-latest
# Override only if using a custom Jules-compatible endpoint
JULES_BASE_URL=https://api.jules.google.com/v1

# FreeModel.dev — free AI model gateway
FREEMODEL_API_KEY=
FREEMODEL_MODEL=gpt-4o-mini
FREEMODEL_BASE_URL=https://api.freemodel.dev/v1

# OpenCode API — opencode.ai gateway
OPENCODE_API_KEY=
OPENCODE_MODEL=opencode-latest
OPENCODE_BASE_URL=https://api.opencode.ai/v1

# Mistral AI — La Plateforme (free tier with phone verification)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# NVIDIA NIM — free tier (phone verification required)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Cloudflare Workers AI — via AI Gateway (free: 10K neurons/day)
CLOUDFLARE_API_KEY=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
# Replace YOUR_ACCOUNT_ID with your Cloudflare account ID
CLOUDFLARE_BASE_URL=https://gateway.ai.cloudflare.com/v1/YOUR_ACCOUNT_ID/default/workers-ai

# Ecosystem deploy orchestration controls
ECOSYSTEM_DEPLOY_WAVE_SIZE=10
ECOSYSTEM_WAVE_RECHECK_SECONDS=15

# ===========================================
# SMSLY Platform Integration (native SMS/Voice/Video)
# ===========================================
# Internal service URLs (within Docker/K8s network)
SMSLY_SMS_API_URL=http://smsly-sms:8000/api/v1
SMSLY_VOICE_API_URL=http://smsly-voice:8000/api/v1
SMSLY_PLATFORM_API_URL=http://smsly-platform-api:8000/api/v1

# Service-to-service authentication
SMSLY_INTERNAL_API_KEY=

# ===========================================
# SMS/Voice Alerting
# ===========================================
# Phone number for deployment failure alerts (E.164 format)
ALERT_PHONE_NUMBER=

# Phone number for critical/P0 voice call alerts
CRITICAL_ALERT_PHONE=

# Enable SMS on successful deployments (default: false)
NOTIFY_ON_SUCCESS=False

# ===========================================
# Optional Settings
# ===========================================
DEBUG=False
USE_SSL=True
SMSLY_DISABLE_TIER_GATES=True
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
SITE_URL=https://your-domain.com
# Explicit GitHub OAuth callback URL (prevents redirect_uri mismatch errors)
GITHUB_OAUTH_CALLBACK_URL=https://your-domain.com/auth/github/callback
CSRF_TRUSTED_ORIGINS=https://your-domain.com
DJANGO_LOG_LEVEL=INFO

# ===========================================
# Observability (Optional)
# ===========================================
GRAFANA_PASSWORD=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# ===========================================
# Docker Addon Provisioning
# ===========================================
# Docker network for service-to-addon connectivity
DOCKER_NETWORK=smsly-net

# ===========================================
# Traefik Proxy (Optional - alternative to nginx Ingress)
# ===========================================
# Email for Let's Encrypt SSL certificates
ACME_EMAIL=admin@smsly.cloud

# Dashboard domain (set to your actual domain)
DOMAIN=your-domain.com

# Optional: override if your frontend origin is different than https://DOMAIN
# SITE_URL=https://your-domain.com

# Dashboard auth (generate: htpasswd -nb admin yourpassword)
TRAEFIK_DASHBOARD_AUTH=

# ===========================================
# Email (SMTP)
# ===========================================
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@smsly.cloud
