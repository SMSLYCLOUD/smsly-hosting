# Environment variables for SMSly Hosting
# Copy this to .env and fill in all REQUIRED values

# ===========================================
# REQUIRED - Service will not start without these
# ===========================================

# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ===========================================
# Database & Redis (defaults work for docker-compose)
# ===========================================
DATABASE_URL=postgres://postgres:postgres@db:5432/smsly_hosting
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_prod
REDIS_URL=redis://:change_me_in_prod@redis:6379/0
CELERY_BROKER_URL=redis://:change_me_in_prod@redis:6379/0

# Required in production for webhook signature validation (fail-closed if missing)
GITHUB_WEBHOOK_SECRET=

# Optional explicit inter-service HMAC secret (falls back to SECRET_KEY if unset)
GATEWAY_SECRET=

# ===========================================
# CORS Configuration
# ===========================================
# Set to True ONLY for local development
CORS_ALLOW_ALL=False
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://cloud.smsly.cloud

# ===========================================
# Container Registry (required for deployments)
# ===========================================
CONTAINER_REGISTRY_URL=registry.smsly.cloud
REGISTRY_USER=
REGISTRY_PASSWORD=

# ===========================================
# SMSLY Platform Integration (native SMS/Voice/Video)
# ===========================================
# Internal service URLs (within Docker/K8s network)
SMSLY_SMS_API_URL=http://smsly-sms:8000/api/v1
SMSLY_VOICE_API_URL=http://smsly-voice:8000/api/v1
SMSLY_PLATFORM_API_URL=http://smsly-platform-api:8000/api/v1

# Service-to-service authentication
SMSLY_INTERNAL_API_KEY=

# ===========================================
# SMS/Voice Alerting
# ===========================================
# Phone number for deployment failure alerts (E.164 format)
ALERT_PHONE_NUMBER=

# Phone number for critical/P0 voice call alerts
CRITICAL_ALERT_PHONE=

# Enable SMS on successful deployments (default: false)
NOTIFY_ON_SUCCESS=False

# ===========================================
# Optional Settings
# ===========================================
DEBUG=False
ALLOWED_HOSTS=localhost,cloud.smsly.cloud
CSRF_TRUSTED_ORIGINS=https://cloud.smsly.cloud
DJANGO_LOG_LEVEL=INFO

# ===========================================
# Docker Addon Provisioning
# ===========================================
# Docker network for service-to-addon connectivity
DOCKER_NETWORK=smsly-hosting-network

# ===========================================
# Traefik Proxy (Optional - alternative to nginx Ingress)
# ===========================================
# Email for Let's Encrypt SSL certificates
ACME_EMAIL=admin@smsly.cloud

# Dashboard domain (set to your actual domain)
DOMAIN=cloud.smsly.cloud

# Dashboard auth (generate: htpasswd -nb admin yourpassword)
TRAEFIK_DASHBOARD_AUTH=
