# Environment variables for SMSly Hosting
# Copy this to .env and fill in all REQUIRED values

# ===========================================
# Deployment / compose file (used by install.sh --update)
# ===========================================
# Master mode: leave as docker-compose.yml (base file with traefik + caddy inlined).
# Agent-lite mode: install.sh overwrites this to infrastructure/docker/docker-compose.agent-lite.yml.
COMPOSE_FILE=docker-compose.yml

# ===========================================
# Domain configuration (REQUIRED)
# ===========================================
# The primary domain of your deployment. Used for OAuth callbacks, CORS, Caddy, etc.
# Examples:
#   DOMAIN=grid.example.com
#   DOMAIN=localhost  (for local dev)
DOMAIN=your-domain.com

# Optional subdomains (defaults work for most setups)
# CONTAINER_REGISTRY_URL=registry.${DOMAIN}
# ACME_EMAIL=admin@${DOMAIN}
# DEFAULT_FROM_EMAIL=noreply@${DOMAIN}
# AI_SENATE_URL=https://senate.${DOMAIN}

# === Domain-related overrides ===
# Tunnel base domain (subdomain for tunnel URLs)
# Default: tunnel.${DOMAIN}
# Examples: tunnel.example.com (custom), auto.sslip.io (auto-public)
# TUNNEL_BASE_DOMAIN=

# Additional ALLOWED_HOSTS entries (production only; dev auto-allows .cprapid.com and .sslip.io)
# Comma-separated: ALLOWED_HOSTS_EXTRAS=cdn.example.com,api.example.com
# ALLOWED_HOSTS_EXTRAS=

# ===========================================
# REQUIRED - Service will not start without these
# ===========================================

# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ===========================================
# Database & Redis (defaults work for docker-compose)
# ===========================================
# These MUST match docker-compose.prod.yml expectations
POSTGRES_DB=smsly_hosting
POSTGRES_USER=smsly_admin
POSTGRES_PASSWORD=
DATABASE_URL=postgres://smsly_admin:${POSTGRES_PASSWORD}@pgcat:5432/smsly_hosting
REDIS_HOST=redis-primary
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
# NOTE: REDIS_URL and CELERY_BROKER_URL are auto-generated by the install
# scripts from the values above. You may override them here if needed.
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis-primary:6379/0
# CELERY_BROKER_URL=amqp://smsly_user:${RABBITMQ_PASSWORD}@rabbitmq:5672//

# ── Celery Worker Autoscaling ────────────────────────────────────────
# When enabled, celery-2 and celery-3 are started/stopped automatically
# based on queue depth. The primary celery worker always runs.
CELERY_AUTOSCALE_ENABLED=true
CELERY_SCALE_UP_THRESHOLD=50      # Start extra workers when queue > N tasks
CELERY_SCALE_DOWN_THRESHOLD=5     # Stop extra workers when queue < N tasks
CELERY_SCALE_UP_AFTER=60          # Seconds above threshold before scaling up
CELERY_SCALE_DOWN_AFTER=300       # Seconds below threshold before scaling down
CELERY_SCALE_CHECK_INTERVAL=15    # Polling interval in seconds
# Queues for the main celery worker. When autoscaler is disabled, set to
# "celery,fast,deploy" so the standalone worker handles all task types.
CELERY_QUEUES=celery,fast,deploy

# ── Redis Sentinel (HA) ──────────────────────────────────────────────
# Set SENTINEL_HOSTS to enable Sentinel mode (e.g. "sentinel1:26379,sentinel2:26379,sentinel3:26379")
SENTINEL_HOSTS=
SENTINEL_SERVICE_NAME=mymaster
SENTINEL_PASSWORD=

# ── Redis Durability ──────────────────────────────────────────────────
# min-replicas-to-write: Redis will refuse writes if fewer than this many
# replicas are connected. Default 1 ensures every write is replicated before
# acknowledged. Set to 0 in single-node dev/test to avoid write failures.
REDIS_MIN_REPLICAS_TO_WRITE=1
REDIS_MIN_REPLICAS_MAX_LAG=10

# ── Database HA mode ──────────────────────────────────────────────────
# Controls which PostgreSQL stack docker compose starts (see
# docker-compose.prod.yml service profiles):
#
#   local-ha  — postgres-primary + postgres-replica + pgcat (legacy,
#               manual failover via scripts/promote-replica.sh)
#   patroni   — Patroni/Spilo 3-node cluster + etcd + HAProxy + pgcat
#               (automatic failover, ~30s detection via REST health checks)
#   external  — no local DB containers; DATABASE_URL must point at an
#               externally managed PostgreSQL instance. pgcat still runs
#               and pools connections in front of it.
#
# The value of DB_HA_ENABLED is passed to `docker compose --profile <mode>`.
# Default for existing deployments: local-ha.
DB_HA_ENABLED=local-ha

# PgCat upstream (where the pooler forwards queries).
#   local-ha mode:  PGCAT_DB_HOST=postgres-primary, PGCAT_DB_PORT=5432
#   patroni mode:   PGCAT_DB_HOST=haproxy,          PGCAT_DB_PORT=5000
#                   DB_REPLICA_HOSTS=haproxy:5001
#   external mode:  set both vars to your managed PG host/port and update
#                   DATABASE_URL accordingly.
PGCAT_DB_HOST=postgres-primary
PGCAT_DB_PORT=5432

# Patroni superuser password (patroni mode only). Used by the 'postgres'
# role inside Spilo and by the one-shot patroni-db-init bootstrap job.
PATRONI_SUPERUSER_PASSWORD=

# ── PostgreSQL streaming replication ──────────────────────────────────
REPLICATION_PASSWORD=
DB_REPLICA_HOSTS=

# ── PostgreSQL Durability ──────────────────────────────────────────────
# synchronous_commit: when to acknowledge a commit for durability.
#   on       — wait for local WAL flush (default, equivalent to AOF fsync)
#   remote_write — wait for replica to write WAL to disk
#   remote_apply — wait for replica to write AND apply (strongest, slowest)
#   off      — no wait (fastest, risk of losing recent commits on crash)
PG_SYNCHRONOUS_COMMIT=on
# synchronous_standby_names: comma-separated list of standby application_names
# that must acknowledge commits. Set to '*' (default) to require at least one
# sync standby. Leave empty for async replication.
# Set to 'FIRST 1 (replica_name)' to require a specific standby.
# WARNING: if the named standby is offline, all writes will block.
PG_SYNCHRONOUS_STANDBY_NAMES='*'

# REQUIRED in production - backend crashes without it (fail-closed security).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# REQUIRED in production for PgCat service.
# Generate: python3 -c "import secrets; print(secrets.token_hex(48))"
PGCAT_ADMIN_PASSWORD=

# REQUIRED in production for FRP tunnel relay.
# Generate: python3 -c "import secrets; print(secrets.token_hex(64))"
FRP_AUTH_TOKEN=

# REQUIRED in production for autoscaler API authentication.
# Generate: python3 -c "import secrets; print(secrets.token_hex(64))"
AUTOSCALER_API_TOKEN=

# REQUIRED in production for backup encryption (Fernet key).
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=

# Refuse to write unencrypted backups (default: true in production).
BACKUP_REQUIRE_ENCRYPTION=true

# Docker registry internal secret (auto-generated on update if missing).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
REGISTRY_HTTP_SECRET=

# Grafana admin password (if using observability stack).
# Generate: python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'-_') for _ in range(40)))"
GRAFANA_PASSWORD=

# CrowdSec bouncer key for Traefik integration (if using CrowdSec).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
CROWDSEC_BOUNCER_KEY=

# --- INFRASTRUCTURE & PROVISIONING ---
# Branch to use for remote server updates (default: main)
SMSLY_BRANCH=main

# Docker Buildx fallback builder name (Batch J)
# The default ``docker`` driver buildx builder can corrupt on
# Docker daemon restarts; the platform auto-creates a fallback
# with this name using the more-resilient ``docker-container``
# driver when a build fails with
#   ``failed to recreate the buildx default builder with the
#   docker driver``.
# Operators can pre-create it with:
#   docker buildx create --name smsly-fallback \
#     --driver docker-container --use
# Or force a specific builder globally with BUILDX_BUILDER=...
BUILDX_FALLBACK_BUILDER=smsly-fallback

# Remote repository URL for provisioning (default: SMSLYCLOUD/smsly-hosting.git)
# Token injection is handled automatically by the provisioner.
SMSLY_GIT_REMOTE=https://github.com/SMSLYCLOUD/smsly-hosting.git

# Optional explicit inter-service HMAC secret (REQUIRED in production;
# falls back to SECRET_KEY only in tests / DEBUG mode).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# This must be a separate value from SECRET_KEY.
GATEWAY_SECRET=

# Shared secret for the Caddy on_demand_tls 'ask' endpoint. Caddy calls
# POST /api/v1/services/check-domain/ to ask "is this hostname yours?";
# the backend requires the X-Caddy-Secret header to match this value
# (see CaddySecretOrAdminPermission in apps/deployments/views.py).
# MUST be set in production — if unset, the backend generates a random
# UUID at startup, logs a warning, and the secret is lost on restart.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
CADDY_ASK_SECRET=

# ===========================================
# OAuth (Optional - enables GitHub/Google login)
# ===========================================
# Create OAuth apps and set these credentials, then restart the backend.
# The backend will auto-configure the Django Site + SocialApps on startup.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================
# GitHub App (Enterprise Git Auth — Optional)
# ===========================================
# Used for building private repos without depending on a user's personal OAuth token.
# Generates short-lived (1hr), repo-scoped tokens at build time. Zero stored tokens.
#
# FALLBACK BEHAVIOUR: If unset, the platform falls back to the service owner's
# linked GitHub OAuth token automatically. You can leave these blank until you
# create the GitHub App — everything still works via OAuth.
#
# Setup (one-time):
#   1. Go to: https://github.com/organizations/SMSLYCLOUD/settings/apps/new
#   2. Name: smsly-paas-builder
#   3. Permissions -> Repository -> Contents: Read-only
#   4. Installation scope: Only on this account, select repos (smsly-shared)
#   5. Create app, note App ID, generate & download private key (.pem)
#   6. Install the app on SMSLYCLOUD org
#
# App ID (not secret — shown on the GitHub App settings page)
GITHUB_APP_ID=
#
# Private key PEM (secret — downloaded from GitHub App settings -> Generate private key)
# Paste the full PEM on one line with literal \n between lines, e.g.:
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----
# NEVER commit this value.
GITHUB_APP_PRIVATE_KEY=

# ===========================================
# Billing (Optional)
# ===========================================
# Stripe (recommended for recurring subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Non-Stripe providers (Flutterwave/Cryptomus) use one-time "period" activations
BILLING_CURRENCY=USD
BILLING_PRO_AMOUNT=29.00
BILLING_PRO_PERIOD_DAYS=30

# Flutterwave (card/bank payments)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Cryptomus (crypto payments)
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# ===========================================
# CORS Configuration
# ===========================================
# Set to True ONLY for local development
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated list of allowed origins (replace your-domain.com with the value of DOMAIN)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
# Legacy function-based tunnel API (keep disabled unless required)
ENABLE_LEGACY_TUNNEL_API=False
# Provisioner SSH host-key verification (set False only for bootstrap/trusted labs)
SMSLY_STRICT_SSH_HOST_KEY_CHECK=False

# ===========================================
# Container Registry (required for deployments)
# ===========================================
# Container registry URL (used by deploy workers to push images)
# Default: registry.${DOMAIN} (set DOMAIN at the top of this file)
# Container registry URL. Default is registry:5000 (Docker overlay DNS —
# resolves inside smsly-net for inter-container pushes). For host-level
# access or remote nodes, use the WireGuard mesh IP (10.100.0.1:5000)
# or a Caddy-routed domain (registry.${DOMAIN}).
# CONTAINER_REGISTRY_URL=registry:5000
# CONTAINER_REGISTRY_URL=registry.${DOMAIN}
REGISTRY_USER=
REGISTRY_PASSWORD=

# ===========================================
# AI Intelligence Providers (optional)
# ===========================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
JULES_API_KEY=
JULES_MODEL=jules-latest
# Override only if using a custom Jules-compatible endpoint
JULES_BASE_URL=https://api.jules.google.com/v1

# FreeModel.dev — free AI model gateway
FREEMODEL_API_KEY=
FREEMODEL_MODEL=gpt-4o-mini
FREEMODEL_BASE_URL=https://api.freemodel.dev/v1

# OpenCode API — opencode.ai gateway
OPENCODE_API_KEY=
OPENCODE_MODEL=opencode-latest
OPENCODE_BASE_URL=https://api.opencode.ai/v1

# Mistral AI — La Plateforme (free tier with phone verification)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# NVIDIA NIM — free tier (phone verification required)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Cloudflare Workers AI — via AI Gateway (free: 10K neurons/day)
CLOUDFLARE_API_KEY=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
# Replace YOUR_ACCOUNT_ID with your Cloudflare account ID
CLOUDFLARE_BASE_URL=https://gateway.ai.cloudflare.com/v1/YOUR_ACCOUNT_ID/default/workers-ai

# Ecosystem deploy orchestration controls
ECOSYSTEM_DEPLOY_WAVE_SIZE=10
ECOSYSTEM_WAVE_RECHECK_SECONDS=15

# Maximum file size in bytes returned by container file_read endpoint (default: 10485760 = 10 MB). Increase cautiously — large files may cause memory pressure.
SMSLY_MAX_FILE_READ_SIZE=10485760

# ===========================================
# SMSLY Platform Integration (native SMS/Voice/Video)
# ===========================================
# Internal service URLs (within Docker/K8s network)
SMSLY_SMS_API_URL=http://smsly-sms:8000/api/v1
SMSLY_VOICE_API_URL=http://smsly-voice:8000/api/v1
SMSLY_PLATFORM_API_URL=http://smsly-platform-api:8000/api/v1

# Service-to-service authentication
SMSLY_INTERNAL_API_KEY=

# ===========================================
# SMS/Voice Alerting
# ===========================================
# Phone number for deployment failure alerts (E.164 format)
ALERT_PHONE_NUMBER=

# Phone number for critical/P0 voice call alerts
CRITICAL_ALERT_PHONE=

# Enable SMS on successful deployments (default: false)
NOTIFY_ON_SUCCESS=False

# ===========================================
# Frontend Map Visualization (Optional)
# ===========================================
# Mapbox GL token for the traffic world map on the Metrics page.
# Get free token at https://account.mapbox.com/access-tokens/
# Free tier: 50K map loads/month.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ===========================================
# Optional Settings
# ===========================================
DEBUG=False
USE_SSL=True
SMSLY_DISABLE_TIER_GATES=True
# Replace your-domain.com with the value of DOMAIN (set at the top of this file)
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
# Replace your-domain.com with the value of DOMAIN (set at the top of this file)
SITE_URL=https://your-domain.com
# Explicit GitHub OAuth callback URL (prevents redirect_uri mismatch errors)
# Replace your-domain.com with the value of DOMAIN (set at the top of this file)
GITHUB_OAUTH_CALLBACK_URL=https://your-domain.com/auth/github/callback
# Replace your-domain.com with the value of DOMAIN (set at the top of this file)
CSRF_TRUSTED_ORIGINS=https://your-domain.com
DJANGO_LOG_LEVEL=INFO

# ===========================================
# Resource Limits (adjust to your server hardware)
# ===========================================
# Docker memory limits per service.  Use Docker format: 512M, 1G, 2G, etc.
# Set to empty string ("") for no limit.  Defaults shown below are for
# a 4-8 GB server; scale up/down based on total host RAM.
DB_MEMORY_LIMIT=4G
DB_MEMORY_RESERVATION=1G
REDIS_MEMORY_LIMIT=512M
REDIS_MEMORY_RESERVATION=256M
RABBITMQ_MEMORY_LIMIT=1G
RABBITMQ_MEMORY_RESERVATION=256M
BACKEND_MEMORY_LIMIT=2G
BACKEND_MEMORY_RESERVATION=512M
PGCAT_MEMORY_LIMIT=256M
REGISTRY_MEMORY_LIMIT=1G
DOCKER_MIRROR_MEMORY_LIMIT=512M
FRONTEND_MEMORY_LIMIT=1G
CADDY_MEMORY_LIMIT=512M
FRPS_MEMORY_LIMIT=256M
ROUTE_FALLBACK_MEMORY_LIMIT=128M
# Number of gunicorn workers (set to "auto" for nproc auto-detection)
GUNICORN_WORKERS=4
# Replication password for HA PostgreSQL setup (docker-compose.ha-postgres.yml)
REPLICATION_PASSWORD=
# Frontend instances — Docker DNS round-robins across replicas. Increase for
# high-traffic deployments.  Set via docker compose --scale frontend=N.
FRONTEND_REPLICAS=1
# Backend instances — Docker DNS round-robins.  NOTE: WebSocket connections
# require sticky sessions; scale cautiously if using real-time features.
BACKEND_REPLICAS=1
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# ===========================================
# Docker Addon Provisioning
# ===========================================
# Docker network for service-to-addon connectivity
DOCKER_NETWORK=smsly-net

# ===========================================
# Traefik Proxy (Optional - alternative to nginx Ingress)
# ===========================================
# Email for Let's Encrypt SSL certificates
# ACME_EMAIL=admin@${DOMAIN}
# (DOMAIN is set at the top of this file)

# Optional: override if your frontend origin is different than https://DOMAIN
# SITE_URL=https://your-domain.com

# Dashboard auth (generate: htpasswd -nb admin yourpassword)
TRAEFIK_DASHBOARD_AUTH=

# ===========================================
# Infisical Secret Manager (Optional)
# ===========================================
# Auto-provisioned on first install/update if docker-compose.infisical.yml exists.
# Infisical app secrets (ENCRYPTION_KEY, AUTH_SECRET) are auto-generated and
# persisted to the infisical_data volume — no manual configuration needed.
#
# After Infisical starts, you must create an admin account via the web UI
# (https://secrets.YOUR_DOMAIN) and then generate a service token:
#   1. Sign up at https://secrets.YOUR_DOMAIN (first signup = admin)
#   2. Go to Organization Settings → Service Tokens → Create Token
#   3. Copy the token and set INFISICAL_SERVICE_TOKEN below
#   4. Restart the backend: docker restart smsly-hosting-backend-1
#
# The backend syncs PlatformConfig secrets to Infisical via:
#   python manage.py sync_infisical_secrets --push

# Service token for backend → Infisical API auth (set after first signup)
INFISICAL_SERVICE_TOKEN=

# Internal API URL (Docker network — don't change unless you know what you're doing)
INFISICAL_URL=http://infisical:8080

# Public URL for the Infisical web UI
# INFISICAL_SITE_URL=https://secrets.${DOMAIN}

# SMTP for Infisical email features (optional)
# INFISICAL_SMTP_HOST=
# INFISICAL_SMTP_PORT=587
# INFISICAL_SMTP_USERNAME=
# INFISICAL_SMTP_PASSWORD=
# INFISICAL_SMTP_SECURE=false
# INFISICAL_SMTP_FROM_ADDRESS=

# Restrict signups to invited users only (default: true)
# INFISICAL_INVITE_ONLY=true

# ===========================================
# Email (SMTP)
# ===========================================
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Default "from" address for outgoing emails
# DEFAULT_FROM_EMAIL=noreply@${DOMAIN}
  
# =============================================================================  
# SPIFFE/SPIRE mTLS Configuration  
# =============================================================================  
# Enable mTLS for all tenant services (default: true)  
MTLS_ENABLED=true  
  
# SPIFFE trust domain (used in SPIFFE IDs: spiffe://<domain>/service/<name>)  
SPIFFE_TRUST_DOMAIN=platform.local  
  
# SPIRE agent socket and SVID paths (volume names for Docker)  
SPIRE_SOCKET_HOST_PATH=spire-agent-socket  
SPIRE_SVIDS_HOST_PATH=spire-agent-svids  
  
# SPIRE container names (optional)  
# SPIRE_SERVER_CONTAINER=smsly-spire-server  
# SPIRE_AGENT_CONTAINER=smsly-spire-agent  
# SPIRE_INIT_CONTAINER=smsly-spire-init 
