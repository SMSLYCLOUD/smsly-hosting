# SMSLY Hosting Frontend Environment Variables
# Copy this to .env.local for local development

# Backend API URL (include /api/v1 suffix)
NEXT_PUBLIC_API_URL=https://hosting.smsly.cloud/api/v1

# Internal backend URL for SSR (Docker networking)
INTERNAL_API_URL=http://backend:8000/api/v1

# Public GitHub URL used by landing page CTA
NEXT_PUBLIC_GITHUB_URL=https://github.com/SMSLYCLOUD/smsly-hosting
