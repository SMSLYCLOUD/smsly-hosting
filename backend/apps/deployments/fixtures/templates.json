        "docker_image": "metabase/metabase",
        "default_port": 3000
    },
    {
        "id": "plausible",
        "name": "Plausible Analytics",
        "description": "Simple, open-source, lightweight (< 1 KB) and privacy-friendly web analytics.",
        "icon": "https://plausible.io/assets/img/favicon/favicon.png",
        "category": "Analytics",
        "repository_url": "https://github.com/plausible/analytics",
        "docker_image": "plausible/analytics",
        "default_port": 8000
    }
