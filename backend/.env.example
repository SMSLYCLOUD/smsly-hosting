# Django Settings
SECRET_KEY=your-secret-key-here
FIELD_ENCRYPTION_KEY=your-encryption-key-here
DEBUG=False
ENVIRONMENT=production
ALLOWED_HOSTS=hosting.smsly.cloud,www.hosting.smsly.cloud,localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://smsly:your-password@127.0.0.1:5432/smsly_hosting

# Redis
REDIS_URL=redis://:your-redis-password@127.0.0.1:6379/0

# CORS
CORS_ALLOWED_ORIGINS=https://hosting.smsly.cloud,https://www.hosting.smsly.cloud,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://hosting.smsly.cloud,https://www.hosting.smsly.cloud

# ===== SOCIAL AUTH (OAuth) =====
# GitHub OAuth - https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth Callback URLs (configure in provider dashboards)
# GitHub: https://hosting.smsly.cloud/accounts/github/login/callback/
# Google: https://hosting.smsly.cloud/accounts/google/login/callback/

# ===== EMAIL =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@smsly.cloud

# ===== NODE SSH CREDENTIALS (for self-healing system) =====
# Set these on lite agent nodes so the system can SSH in for auto-recovery.
# Credentials are encrypted at rest in the database via EncryptedCharField.
# NODE_SSH_PASSWORD=your-root-password
# NODE_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----
# NODE_HOST=69.164.244.51

# ===== OPTIONAL SERVICES =====
# Container Registry
CONTAINER_REGISTRY_URL=

# AI Features
GEMINI_API_KEY=

# Sentry Error Tracking
SENTRY_DSN=

# Site URL (for OAuth redirects)
SITE_URL=https://hosting.smsly.cloud
