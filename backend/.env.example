# Django Settings
SECRET_KEY=your-secret-key-here
FIELD_ENCRYPTION_KEY=your-encryption-key-here
DEBUG=False
ENVIRONMENT=production
ALLOWED_HOSTS=hosting.smsly.cloud,www.hosting.smsly.cloud,localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://smsly:your-password@127.0.0.1:5432/smsly_hosting

# Redis
REDIS_URL=redis://:your-redis-password@127.0.0.1:6379/0

# CORS
CORS_ALLOWED_ORIGINS=https://hosting.smsly.cloud,https://www.hosting.smsly.cloud,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://hosting.smsly.cloud,https://www.hosting.smsly.cloud

# Container Registry (optional)
CONTAINER_REGISTRY_URL=

# AI Features (optional)
# GEMINI_API_KEY=
